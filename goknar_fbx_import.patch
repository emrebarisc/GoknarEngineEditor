+void FileBrowserPanel::ImportFBXFileSystemItem(const std::string& source)
+{
+	if (pendingImportDirectory_.empty())
+	{
+		return;
+	}
+
+	const std::filesystem::path sourcePath = std::filesystem::path(source).lexically_normal();
+	const std::filesystem::path destinationPath =
+		(std::filesystem::path(pendingImportDirectory_) / sourcePath.filename()).lexically_normal();
+	pendingImportDirectory_.clear();
+
+	if (GetLowerExtension(sourcePath.string()) != "fbx" || sourcePath == destinationPath)
+	{
+		return;
+	}
+
+	std::error_code errorCode;
+	if (!std::filesystem::is_regular_file(sourcePath, errorCode) || errorCode)
+	{
+		return;
+	}
+
+	if (std::filesystem::exists(destinationPath, errorCode) || errorCode)
+	{
+		return;
+	}
+
+	std::filesystem::copy_file(sourcePath, destinationPath, std::filesystem::copy_options::none, errorCode);
+	if (!errorCode)
+	{
+		needsRefresh_ = true;
+	}
+}
